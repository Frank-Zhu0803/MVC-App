@model IEnumerable<AwesomeTickets.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center my-4">
        <h1>Events Management</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">All Events</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Title)</th>
                            <th class="d-none d-md-table-cell">@Html.DisplayNameFor(model => model.Description)</th>
                            <th>Image</th>
                            <th class="d-none d-md-table-cell">@Html.DisplayNameFor(model => model.EventDateTime)</th>
                            <th class="d-none d-lg-table-cell">@Html.DisplayNameFor(model => model.Location)</th>
                            <th>@Html.DisplayNameFor(model => model.Price)</th>
                            <th>@Html.DisplayNameFor(model => model.AvailableQuantity)</th>
                            <th class="d-none d-lg-table-cell">@Html.DisplayNameFor(model => model.Category)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td>
                                <span class="fw-medium">@Html.DisplayFor(modelItem => item.Title)</span>
                            </td>
                            <td class="d-none d-md-table-cell">
                                <div class="text-truncate" style="max-width: 150px;">@Html.DisplayFor(modelItem => item.Description)</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageFilename))
                                {
                                    <img src="~/event-images/@item.ImageFilename" alt="@item.Title" class="img-thumbnail" style="max-height: 50px; max-width: 50px;" />
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No Image</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">
                                @item.EventDateTime.ToString("MMM dd, yyyy - h:mm tt")
                            </td>
                            <td class="d-none d-lg-table-cell">
                                @Html.DisplayFor(modelItem => item.Location)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Price)
                            </td>
                            <td>
                                <span class="@(item.AvailableQuantity > 10 ? "text-success" : item.AvailableQuantity > 0 ? "text-warning" : "text-danger")">
                                    @Html.DisplayFor(modelItem => item.AvailableQuantity)
                                </span>
                            </td>
                            <td class="d-none d-lg-table-cell">
                                <span class="badge bg-primary">@Html.DisplayFor(modelItem => item.Category.Title)</span>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-secondary">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
