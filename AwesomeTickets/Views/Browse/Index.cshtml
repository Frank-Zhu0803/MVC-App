@model IEnumerable<AwesomeTickets.Models.Event>

@{
    ViewData["Title"] = "Browse Events";
}

<div class="container my-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 fw-bold">Discover Amazing Events</h1>
            <p class="lead">Find and book tickets for the best upcoming events</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" aria-live="polite">
            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4" role="list">
        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-4 col-xl-3">
                <div class="card h-100 shadow-sm" tabindex="0" role="article" aria-labelledby="event-title-@item.EventId">
                    @if (!string.IsNullOrEmpty(item.ImageFilename))
                    {
                        <img src="~/event-images/@item.ImageFilename" class="card-img-top" alt="Event image for @item.Title" style="height: 180px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 180px;" aria-hidden="true">
                            <span class="text-muted">No Image</span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0 text-truncate" id="event-title-@item.EventId">@item.Title</h5>
                            <span class="badge bg-primary" aria-label="Category: @item.Category.Title">@item.Category.Title</span>
                        </div>
                        <p class="card-text text-truncate small mb-2">@item.Description</p>
                        <div class="mt-auto">
                            <div class="small mb-2">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="bi bi-calendar-event me-2 text-secondary" aria-hidden="true"></i>
                                    <span>@item.EventDateTime.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <i class="bi bi-clock me-2 text-secondary" aria-hidden="true"></i>
                                    <span>@item.EventDateTime.ToString("h:mm tt")</span>
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <i class="bi bi-geo-alt me-2 text-secondary" aria-hidden="true"></i>
                                    <span class="text-truncate">@item.Location</span>
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0">@item.Price.ToString("C")</h6>
                                <span class="small @(item.AvailableQuantity > 10 ? "text-success" : item.AvailableQuantity > 0 ? "text-warning" : "text-danger")" 
                                      aria-label="@(item.AvailableQuantity > 0 ? $"{item.AvailableQuantity} tickets left" : "Sold out")">
                                    @(item.AvailableQuantity > 0 ? $"{item.AvailableQuantity} left" : "Sold out")
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top-0">
                        <div class="d-flex justify-content-between">
                            <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-primary w-100 me-1" aria-label="View details for @item.Title">
                                <i class="bi bi-info-circle me-1" aria-hidden="true"></i> Details
                            </a>
                            
                            @if (User.Identity.IsAuthenticated)
                            {
                                @if (item.AvailableQuantity > 0)
                                {
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="w-100 ms-1">
                                        <input type="hidden" name="eventId" value="@item.EventId" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-sm btn-primary w-100" aria-label="Add @item.Title to cart">
                                            <i class="bi bi-cart-plus me-1" aria-hidden="true"></i> Add
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary w-100 ms-1" disabled aria-label="Sold out">Sold Out</button>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    
    @if (!Model.Any())
    {
        <div class="text-center py-5" role="alert" aria-live="polite">
            <i class="bi bi-calendar-x display-1 text-muted" aria-hidden="true"></i>
            <h3 class="mt-3">No events available</h3>
            <p class="text-muted">Check back later for upcoming events</p>
        </div>
    }
</div> 