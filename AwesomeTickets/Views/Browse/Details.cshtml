@model AwesomeTickets.Models.Event

@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Browse" asp-action="Index">Events</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm h-100">
                @if (!string.IsNullOrEmpty(Model.ImageFilename))
                {
                    <img src="~/event-images/@Model.ImageFilename" class="card-img-top" alt="Event image for @Model.Title" style="max-height: 400px; object-fit: cover;">
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center p-5" style="height: 300px;" aria-hidden="true">
                        <span class="text-muted">No Image Available</span>
                    </div>
                }
                <div class="card-body">
                    <h1 class="card-title mb-3" id="event-title">@Model.Title</h1>
                    <div class="badge bg-primary mb-3" aria-label="Category: @Model.Category.Title">@Model.Category.Title</div>
                    <div class="card-text">
                        <p>@Model.Description</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4 d-lg-sticky-top" style="top: 20px; z-index: 100;">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Event Details</h5>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <p class="mb-3">
                            <i class="bi bi-calendar-event me-2" aria-hidden="true"></i>
                            <strong>Date:</strong> <span>@Model.EventDateTime.ToString("dddd, MMMM dd, yyyy")</span>
                        </p>
                        <p class="mb-3">
                            <i class="bi bi-clock me-2" aria-hidden="true"></i>
                            <strong>Time:</strong> <span>@Model.EventDateTime.ToString("h:mm tt")</span>
                        </p>
                        <p class="mb-3">
                            <i class="bi bi-geo-alt me-2" aria-hidden="true"></i>
                            <strong>Location:</strong> <span>@Model.Location</span>
                        </p>
                        <p class="mb-3">
                            <i class="bi bi-tag me-2" aria-hidden="true"></i>
                            <strong>Category:</strong> <span>@Model.Category.Title</span>
                        </p>
                        <p class="mb-3">
                            <i class="bi bi-ticket-perforated me-2" aria-hidden="true"></i>
                            <strong>Available:</strong> 
                            <span class="@(Model.AvailableQuantity > 10 ? "text-success" : Model.AvailableQuantity > 0 ? "text-warning" : "text-danger") fw-bold"
                                  aria-label="@(Model.AvailableQuantity > 0 ? $"{Model.AvailableQuantity} tickets available" : "Sold out")">
                                @Model.AvailableQuantity
                            </span>
                        </p>
                    </div>

                    <div class="d-flex align-items-center justify-content-center mb-4">
                        <h3 class="text-primary mb-0">@Model.Price.ToString("C")</h3>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert" aria-live="assertive">
                            <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>@TempData["Error"]
                        </div>
                    }
                    
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (Model.AvailableQuantity > 0)
                        {
                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                <input type="hidden" name="eventId" value="@Model.EventId" />
                                <div class="form-group mb-3">
                                    <label for="quantity" class="form-label">Select Quantity</label>
                                    <input type="number" id="quantity" name="quantity" value="1" min="1" max="@Model.AvailableQuantity" 
                                           class="form-control" required aria-describedby="quantity-help">
                                    <div id="quantity-help" class="form-text">Choose between 1 and @Model.AvailableQuantity tickets</div>
                                </div>
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary" aria-label="Add @Model.Title to cart">
                                        <i class="bi bi-cart-plus me-2" aria-hidden="true"></i>Add to Cart
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-warning text-center" role="alert">
                                <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>Sold Out
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-grid gap-2">
                            <a asp-controller="Home" asp-action="Login" class="btn btn-outline-primary" aria-label="Login to buy tickets for @Model.Title">
                                <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Login to Buy Tickets
                            </a>
                        </div>
                    }
                    
                    <div class="mt-3">
                        <a asp-controller="Browse" asp-action="Index" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Back to Events
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 