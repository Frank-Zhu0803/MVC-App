@model AwesomeTickets.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Event Details</h1>
        <div>
            <a asp-action="Edit" asp-route-id="@Model?.EventId" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model?.ImageFilename))
                    {
                        <img src="~/event-images/@Model.ImageFilename" alt="@Model?.Title" class="img-fluid rounded mb-3" style="max-height: 300px; object-fit: contain;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center p-5 rounded mb-3" style="height: 300px;">
                            <span class="text-muted">No Image Available</span>
                        </div>
                    }
                    
                    <h4 class="card-title">@Html.DisplayFor(model => model.Title)</h4>
                    <div class="badge bg-primary mb-3">@Html.DisplayFor(model => model.Category.Title)</div>
                    <h5 class="text-primary mb-3">@Html.DisplayFor(model => model.Price)</h5>
                    <p class="card-text mb-2">
                        <i class="bi bi-calendar-event me-2"></i>
                        @Model?.EventDateTime.ToString("dddd, MMMM dd, yyyy")
                    </p>
                    <p class="card-text mb-2">
                        <i class="bi bi-clock me-2"></i>
                        @Model?.EventDateTime.ToString("h:mm tt")
                    </p>
                    <p class="card-text">
                        <i class="bi bi-geo-alt me-2"></i>
                        @Html.DisplayFor(model => model.Location)
                    </p>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Event Information</h5>
                </div>
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Description</h6>
                    <p class="card-text mb-4">@Html.DisplayFor(model => model.Description)</p>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-subtitle mb-2 text-muted">Available Tickets</h6>
                                    <p class="card-text fw-bold fs-4">@Html.DisplayFor(model => model.AvailableQuantity)</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-subtitle mb-2 text-muted">Created Date</h6>
                                    <p class="card-text">@Html.DisplayFor(model => model.CreateDate)</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
